# Supabase project
SUPABASE_PROJECT_REF="your_osiyan_project_ref"
SUPABASE_URL="https://your_osiyan_project_ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"

# Vite client aliases. Never expose a service-role key through a VITE_ variable.
VITE_SUPABASE_URL="https://your_osiyan_project_ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"

# Prisma/Postgres connection.
# For deployed serverless environments, use the Supabase transaction-pooler URL
# for DATABASE_URL and the direct or session-pooler URL for DIRECT_URL.
DATABASE_URL="postgresql://postgres:your_database_password@db.your_osiyan_project_ref.supabase.co:5432/postgres?schema=public&connect_timeout=30"
DIRECT_URL="postgresql://postgres:your_database_password@db.your_osiyan_project_ref.supabase.co:5432/postgres?schema=public&connect_timeout=30"

# Stripe payments.
# STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are server-only — never expose
# either through a VITE_ variable. Only the publishable key belongs in the
# browser bundle.
# The webhook secret comes from the endpoint you register at
# https://dashboard.stripe.com/webhooks (events: payment_intent.succeeded,
# payment_intent.payment_failed, payment_intent.canceled) pointing at
# https://your-domain/api/payments. Locally, `stripe listen --forward-to
# localhost:5173/api/payments` prints a whsec_... to use instead.
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_signing_secret"
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
