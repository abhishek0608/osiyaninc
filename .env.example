# Supabase project
SUPABASE_PROJECT_REF="your_osiyan_project_ref"
SUPABASE_URL="https://your_osiyan_project_ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"

# Vite client aliases. Never expose a service-role key through a VITE_ variable.
VITE_SUPABASE_URL="https://your_osiyan_project_ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"

# Prisma/Postgres connection.
# For deployed serverless environments, use the Supabase transaction-pooler URL
# for DATABASE_URL and the direct or session-pooler URL for DIRECT_URL.
DATABASE_URL="postgresql://postgres:your_database_password@db.your_osiyan_project_ref.supabase.co:5432/postgres?schema=public&connect_timeout=30"
DIRECT_URL="postgresql://postgres:your_database_password@db.your_osiyan_project_ref.supabase.co:5432/postgres?schema=public&connect_timeout=30"
